@model MoodPlaylistGenerator.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="login-wrapper d-flex align-items-center justify-content-center">
    <div class="login-card shadow-lg">
        <div class="text-center mb-4">
            <!-- Logo area -->
            <div class="logo-circle mb-3">
                <i class="bi bi-music-note-beamed"></i>
            </div>
            <h2 class="login-title">MoodPlaylist</h2>
            <p class="login-subtitle">Log in to continue your vibe 🎶</p>
        </div>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success">@TempData["Message"]</div>
        }

        <form asp-action="Login" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="EmailOrUsername" class="form-label">Email or Username</label>
                <div class="input-group stylish-input">
                    <span class="input-group-text bg-transparent border-0 text-success">
                        <i class="bi bi-person-circle"></i>
                    </span>
                    <input asp-for="EmailOrUsername" class="form-control bg-transparent border-0 text-white" placeholder="Enter email or username" />
                </div>
                <span asp-validation-for="EmailOrUsername" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="input-group stylish-input">
                    <span class="input-group-text bg-transparent border-0 text-success">
                        <i class="bi bi-lock-fill"></i>
                    </span>
                    <input asp-for="Password" class="form-control bg-transparent border-0 text-white" type="password" placeholder="Enter password" />
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                    <label asp-for="RememberMe" class="form-check-label">Remember me</label>
                </div>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn login-btn">Login</button>
            </div>
        </form>

        <div class="mt-4 text-center">
            <a asp-action="Register" class="alt-link">Don't have an account? <b>Register</b></a><br />
            <a asp-action="ForgotPassword" class="alt-link">Forgot your password?</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    body {
        background: linear-gradient(135deg, #121212, #1db954 40%, #121212);
        font-family: 'Poppins', sans-serif;
        color: #fff;
        min-height: 100vh;
        margin: 0;
    }

    .login-wrapper {
        height: 100vh;
    }

    .login-card {
        background: rgba(18, 18, 18, 0.95);
        border-radius: 20px;
        padding: 2.5rem;
        width: 100%;
        max-width: 420px;
        color: #fff;
        text-align: center;
    }

    .logo-circle {
        width: 70px;
        height: 70px;
        background: #1db954;
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin: 0 auto;
        box-shadow: 0 0 15px rgba(29,185,84,0.6);
    }

    .login-title {
        font-size: 2rem;
        font-weight: 700;
        background: linear-gradient(90deg, #1db954, #00ff9d);
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        -webkit-text-fill-color: transparent;
        display: inline-block;
    }

    .login-subtitle {
        color: #b3b3b3;
        font-size: 0.9rem;
    }

    .form-label {
        color: #b3b3b3;
        text-align: left;
        display: block;
        margin-bottom: 5px;
    }

    .stylish-input {
        background: #181818;
        border: 1px solid #333;
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
    }

        .stylish-input:focus-within {
            border-color: #1db954;
            box-shadow: 0 0 8px rgba(29,185,84,0.6);
            background: #222;
        }

    .form-control {
        background: transparent;
        border: none;
        color: #fff !important; /* FIX: makes text visible */
    }

        .form-control::placeholder {
            color: #888;
        }

    .login-btn {
        background: #1db954;
        border: none;
        border-radius: 12px;
        padding: 12px;
        font-weight: 600;
        font-size: 1rem;
        transition: 0.3s ease;
    }

        .login-btn:hover {
            background: #1ed760;
            box-shadow: 0 0 15px rgba(29,185,84,0.8);
        }

    .alt-link {
        color: #b3b3b3;
        text-decoration: none;
        font-size: 0.9rem;
    }

        .alt-link:hover {
            color: #1db954;
        }

    .input-group-text {
        font-size: 1.2rem;
    }
</style>
